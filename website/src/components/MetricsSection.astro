---
import { repoData } from '../lib/repoData';
const { ruleCount, domainCount, playbookCount, sampleScan, domains } = repoData;
const domainList = domains.slice(0, 6).map((d) => d.label.toLowerCase()).join(', ');
---

<section id="metrics">
  <div class="wrap">
    <div class="kicker">Posture at a glance</div>
    <div class="metric-grid">
      <div class="metric"><div class="num">{ruleCount}</div><div class="lbl">Rules</div><p>Across {domainCount} domains: {domainList} and more.</p><span class="delta">+106 since v0.1.0</span></div>
      <div class="metric"><div class="num">4</div><div class="lbl">Frameworks</div><p>CIS, NIST CSF, ISO 27001 and SOC 2 mapped per finding.</p><span class="delta">declared in every rule</span></div>
      <div class="metric"><div class="num">{playbookCount}</div><div class="lbl">Playbooks</div><p>A fix_az_*.sh remediation script for every rule, ready to run.</p><span class="delta">+48 since v0.1.0</span></div>
      <div class="metric"><div class="num">{sampleScan.score}<span class="unit">/100</span></div><div class="lbl">Sample scan</div><p>{sampleScan.high} high, {sampleScan.medium} medium, {sampleScan.passing} passing on the demo subscription.</p><span class="delta">score 0 to 100</span></div>
    </div>
    <div class="badges">
      <span class="badge b1">reader role only</span>
      <span class="badge b2">python 3.11</span>
      <span class="badge b3">react dashboard</span>
      <span class="badge b4">sentinel export</span>
    </div>
  </div>
</section>
